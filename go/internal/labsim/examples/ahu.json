{
  "name": "air-handling unit",
  "unknown_unit": "silent",
  "devices": [
    {
      "name": "ahu-1",
      "unit": 1,
      "bacnet": {"device_instance": 1001, "description": "air-handling unit 1", "cov": true},
      "points": [
        {"name": "fan_command", "table": "coil", "address": 0, "value": 1, "writable": true,
         "bacnet": {"object_type": "binary-output", "instance": 1, "commandable": true, "active_text": "Run", "inactive_text": "Stop"}},
        {"name": "heating_enable", "table": "coil", "address": 1, "value": 0, "writable": true,
         "bacnet": {"object_type": "binary-value", "instance": 1, "active_text": "Enabled", "inactive_text": "Disabled"}},
        {"name": "fan_status", "table": "discrete_input", "address": 0, "value": 1,
         "bacnet": {"object_type": "binary-input", "instance": 1, "active_text": "Running", "inactive_text": "Stopped"}},
        {"name": "filter_alarm", "table": "discrete_input", "address": 1, "value": 0,
         "bacnet": {"object_type": "binary-input", "instance": 2}},
        {"name": "freeze_alarm", "table": "discrete_input", "address": 2, "value": 0,
         "bacnet": {"object_type": "binary-input", "instance": 3}},
        {"name": "supply_air_temp_x10", "table": "input_register", "address": 0, "type": "int16", "value": 180,
         "behaviour": {"kind": "sine", "amplitude": 15, "period_ms": 120000},
         "bacnet": {"object_type": "analog-input", "instance": 1, "description": "supply air temperature, tenths of a degree"}},
        {"name": "return_air_temp_x10", "table": "input_register", "address": 1, "type": "int16", "value": 225,
         "behaviour": {"kind": "random_walk", "seed": 11, "step": 2, "interval_ms": 5000, "min": 200, "max": 250},
         "bacnet": {"object_type": "analog-input", "instance": 2, "description": "return air temperature, tenths of a degree"}},
        {"name": "outdoor_air_temp", "table": "input_register", "address": 2, "type": "float32", "order": "ABCD",
         "behaviour": {"kind": "ramp", "min": 5, "max": 25, "period_ms": 600000},
         "bacnet": {"object_type": "analog-input", "instance": 3, "units": "degrees-celsius", "cov_increment": 0.5}},
        {"name": "duct_pressure_pa", "table": "input_register", "address": 4, "type": "uint16", "value": 250,
         "bacnet": {"object_type": "analog-input", "instance": 4, "units": "pascals", "cov_increment": 5}},
        {"name": "runtime_hours", "table": "input_register", "address": 6, "type": "uint32", "value": 12345,
         "bacnet": {"object_type": "analog-input", "instance": 5, "units": "hours"}},
        {"name": "supply_setpoint_x10", "table": "holding_register", "address": 0, "type": "int16", "value": 180, "writable": true,
         "bacnet": {"object_type": "analog-value", "instance": 1, "min_pres_value": 100, "max_pres_value": 300}},
        {"name": "damper_position_pct", "table": "holding_register", "address": 1, "type": "uint16", "value": 35, "writable": true,
         "bacnet": {"object_type": "analog-output", "instance": 1, "units": "percent", "commandable": true, "min_pres_value": 0, "max_pres_value": 100}},
        {"name": "fan_speed_pct", "table": "holding_register", "address": 2, "type": "float32", "order": "ABCD", "value": 42.5, "writable": true,
         "bacnet": {"object_type": "analog-output", "instance": 2, "units": "percent", "commandable": true, "min_pres_value": 0, "max_pres_value": 100}},
        {"name": "fault_code", "table": "holding_register", "address": 10, "type": "uint16", "value": 0,
         "bacnet": {"object_type": "analog-value", "instance": 2}}
      ]
    }
  ]
}
