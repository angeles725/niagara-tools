#!/usr/bin/env bash
# pre-push — client-repository gate: no Java package may be declared in two N4 modules (issue #142).
# Installed by the kit's scripts/install-client-hooks.sh into <client-repo>/.githooks/pre-push; do not edit the
# copy — re-run the installer with --force to update it from the kit template.
#
# For every pushed ref it exports the pushed COMMIT (not the working tree) and runs the kit's
# split-package-check.sh --strict on it. It blocks the push when:
#   - a package is split across two modules (checker exit 1), and
#   - the check cannot run: the kit toolbelt is not found, the commit cannot be exported, or the checker exits 3
#     (no module in the commit, an unreadable file) or any other status.
# It never passes silently. To bypass for one push on purpose: git push --no-verify (operator decision).
#
# Kit toolbelt: $N4_KIT_TOOLBELT, else `git config n4kit.toolbelt` (set per clone by the installer, never committed).
# stdin (git pre-push contract): "<local ref> <local sha> <remote ref> <remote sha>" per ref.
set -u
set -o pipefail   # a git archive failure must not be masked by tar's status

block() { printf 'pre-push: %s\npre-push: push blocked.\n' "$1" >&2; exit "${2:-1}"; }

toolbelt="${N4_KIT_TOOLBELT:-$(git config --get n4kit.toolbelt 2>/dev/null || true)}"
checker="$toolbelt/split-package-check.sh"
if [ -z "$toolbelt" ] || [ ! -f "$checker" ]; then
  block "cannot verify: split-package-check.sh not found (toolbelt '${toolbelt:-unset}'). Run the kit's scripts/install-client-hooks.sh <this-repo>, or set N4_KIT_TOOLBELT." 3
fi

tmp=$(mktemp -d) || block "cannot verify: mktemp failed" 3
trap 'rm -rf "$tmp"' EXIT

rc=0
n=0
while read -r _lref lsha _rref _rsha; do
  [ -n "${lsha:-}" ] || continue
  [[ "$lsha" =~ ^0+$ ]] && continue          # a deletion pushes no content
  n=$((n + 1))
  dir="$tmp/$n"
  mkdir -p "$dir"
  if ! { git archive --format=tar "$lsha" | tar -xf - -C "$dir"; }; then
    printf 'pre-push: cannot verify %s: the commit could not be exported\n' "$lsha" >&2
    rc=3
    continue
  fi
  out=$(bash "$checker" --strict "$dir" 2>&1)
  st=$?
  out=${out//"$dir/"/}
  case "$st" in
    0) ;;
    1) printf '%s\n' "$out" >&2
       printf 'pre-push: split package in %s — one Java package belongs to exactly one module.\n' "$lsha" >&2
       [ "$rc" -eq 3 ] || rc=1 ;;
    *) printf '%s\n' "$out" >&2
       printf 'pre-push: cannot verify %s: split-package-check.sh exited %s.\n' "$lsha" "$st" >&2
       rc=3 ;;
  esac
done

[ "$rc" -eq 0 ] || block "fix the rows above (or push with --no-verify as an explicit operator decision)" "$rc"
exit 0
