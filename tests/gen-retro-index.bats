#!/usr/bin/env bats
# Tests for build-n4-module-kit/toolbelt/gen-retro-index.sh — the GENERATED retro index.
# retros/INDEX.md used to be hand-edited: every kit PR appended or flipped a row, so parallel
# sessions conflicted on it and "keep both sides" resolutions flipped rows. The index is now
# generated from each retro's own header comments (review-status, module, deltas, optional
# index-comment) and NOT committed (.gitignore), so `--check` validates the headers (fails closed);
# readers run toolbelt/kit-state.sh retro-index.
# Exits: 0 written / headers valid · 1 retro-header violation · 3 usage/env.
# [ev: retro generated-retro-index] [ev: retro ledger-generated-not-committed]

setup() {
  TMPDIR_T="$(mktemp -d)"; export TMPDIR_T
  KIT="$(cd "$BATS_TEST_DIRNAME/.." && pwd)/build-n4-module-kit"
  GEN="$KIT/toolbelt/gen-retro-index.sh"
  SWEEP="$KIT/toolbelt/sweep-build-state.sh"
  FK="$TMPDIR_T/kit"
  mkdir -p "$FK/retros"
}
teardown() { rm -rf "$TMPDIR_T"; }

# _mkretro <file> <status> <module> <deltas> [index-comment] — a fixture retro with the header block.
_mkretro() {
  {
    printf '<!-- review-status: %s -->\n' "$2"
    [ -n "$3" ] && printf '<!-- module: %s -->\n' "$3"
    [ -n "$4" ] && printf '<!-- deltas: %s -->\n' "$4"
    [ -n "${5:-}" ] && printf '<!-- index-comment: %s -->\n' "$5"
    printf '# %s\n\nbody\n' "$1"
  } > "$FK/retros/$1"
}

# _rows — the table data rows of the fixture INDEX (every line after the |---| separator).
_rows() { sed -n '/^|---|/,$p' "$FK/retros/INDEX.md" | sed 1d; }

@test "GRI-usage: an unknown flag or extra args exit 3" {
  run bash "$GEN" --bogus "$FK"
  [ "$status" -eq 3 ]
  run bash "$GEN" "$FK" "$FK"
  [ "$status" -eq 3 ]
}

@test "GRI-env: a kit root with no retros/ exits 3" {
  run bash "$GEN" "$TMPDIR_T/nope"
  [ "$status" -eq 3 ]
}

@test "GRI-real: every committed retro header is valid" {
  run bash "$GEN" --check
  [ "$status" -eq 0 ]
  [[ "$output" == *"the retro headers under"*"are valid"* ]]
}

@test "GRI-rows: one row per retro, sorted by date then filename, with the date taken from the filename" {
  # Mutation: GRI-order -- sorting by filename only puts APPLY-PLAN (A > 2) after a later-dated retro
  _mkretro 2026-09-02-zeta.md folded kit 0
  _mkretro 2026-09-01-beta.md pending ColdRoomPan 3
  _mkretro 2026-09-01-alpha.md folded DashboardPan 2
  _mkretro APPLY-PLAN-2026-09-01-plan.md pending kit 0
  run bash "$GEN" "$FK"
  [ "$status" -eq 0 ]
  run _rows
  [ "${lines[0]}" = "| 2026-09-01-alpha.md | DashboardPan | 2026-09-01 | folded | 2 |" ]
  [ "${lines[1]}" = "| 2026-09-01-beta.md | ColdRoomPan | 2026-09-01 | pending | 3 |" ]
  [ "${lines[2]}" = "| APPLY-PLAN-2026-09-01-plan.md | kit | 2026-09-01 | pending | 0 |" ]
  [ "${lines[3]}" = "| 2026-09-02-zeta.md | kit | 2026-09-02 | folded | 0 |" ]
  [ "${#lines[@]}" -eq 4 ]
}

@test "GRI-comment: an index-comment header is emitted as a trailing row comment" {
  # Mutation: GRI-comment -- dropping the index-comment cell loses the disposition that sweep --age reads
  _mkretro 2026-09-01-plan.md pending kit 0 'disposition: worklist-complete — all applied'
  run bash "$GEN" "$FK"
  [ "$status" -eq 0 ]
  run _rows
  [ "${lines[0]}" = "| 2026-09-01-plan.md | kit | 2026-09-01 | pending | 0 | <!-- disposition: worklist-complete — all applied -->" ]
}

@test "GRI-header: the generated file declares itself generated and keeps the table header" {
  _mkretro 2026-09-01-alpha.md folded kit 0
  run bash "$GEN" "$FK"
  [ "$status" -eq 0 ]
  head -1 "$FK/retros/INDEX.md" | grep -qxF '<!-- GENERATED by kit-state from ledger.d/ and retros/ — do not edit; regenerated on pull -->'
  grep -qx '| Retro file | Module | Date | review-status | deltas |' "$FK/retros/INDEX.md"
}

@test "GRI-check: --check validates the headers and writes nothing; it fails once a header breaks" {
  _mkretro 2026-09-01-alpha.md pending kit 1
  run bash "$GEN" --check "$FK"
  [ "$status" -eq 0 ]
  [ ! -e "$FK/retros/INDEX.md" ]
  _mkretro 2026-09-01-alpha.md pending kit ""
  run bash "$GEN" --check "$FK"
  [ "$status" -eq 1 ]
  [[ "$output" == *"2026-09-01-alpha.md"*"deltas"* ]]
}

@test "GRI-nomodule: a retro without a module header is an error naming the file; nothing is written" {
  # Mutation: GRI-required -- defaulting a missing header to an empty cell writes a row nobody can fold
  _mkretro 2026-09-01-alpha.md pending kit 1
  bash "$GEN" "$FK"
  cp "$FK/retros/INDEX.md" "$TMPDIR_T/before"
  _mkretro 2026-09-02-nomod.md pending "" 1
  run bash "$GEN" "$FK"
  [ "$status" -eq 1 ]
  [[ "$output" == *"2026-09-02-nomod.md"* ]]
  [[ "$output" == *"module"* ]]
  cmp -s "$TMPDIR_T/before" "$FK/retros/INDEX.md"
}

@test "GRI-nodeltas: a retro without a numeric deltas header is an error naming the file" {
  _mkretro 2026-09-02-nodelta.md pending kit ""
  run bash "$GEN" "$FK"
  [ "$status" -eq 1 ]
  [[ "$output" == *"2026-09-02-nodelta.md"* ]]
  [[ "$output" == *"deltas"* ]]
  _mkretro 2026-09-02-nodelta.md pending kit many
  run bash "$GEN" "$FK"
  [ "$status" -eq 1 ]
}

@test "GRI-nostatus: a retro without a pending|folded review-status marker is an error naming the file" {
  printf '<!-- module: kit -->\n<!-- deltas: 0 -->\n# x\n' > "$FK/retros/2026-09-03-nostatus.md"
  run bash "$GEN" "$FK"
  [ "$status" -eq 1 ]
  [[ "$output" == *"2026-09-03-nostatus.md"* ]]
  [[ "$output" == *"review-status"* ]]
}

@test "GRI-sweep: sweep-build-state fails on a stale GENERATED index (deltas header changed)" {
  # The marker<->row check cannot see a deltas or module drift; the freshness check can.
  _mkretro 2026-09-01-alpha.md pending kit 1
  bash "$GEN" "$FK"
  printf '<!-- build-state.v1 -->\nmodule: kit\nretro_required: true\nretro_pending: true\n<!-- /build-state.v1 -->\n' > "$FK/BUILD-STATE.md"
  run bash "$SWEEP" "$FK/BUILD-STATE.md" "$FK/retros" "$FK/retros/INDEX.md"
  [ "$status" -eq 0 ]
  sed -i 's/deltas: 1/deltas: 2/' "$FK/retros/2026-09-01-alpha.md"
  run bash "$SWEEP" "$FK/BUILD-STATE.md" "$FK/retros" "$FK/retros/INDEX.md"
  [ "$status" -eq 1 ]
  [[ "$output" == *"stale"* ]]
}

@test "GRI-go: the wrapper exits 3 naming the cause when the Go module or the go toolchain is missing" {
  # The bash entry point execs go/bin/gen-retro-index, building it first when missing; it never
  # falls back silently. A copy outside the repo has no go/ module; a PATH without go cannot build.
  local top="$TMPDIR_T/top"
  mkdir -p "$top/build-n4-module-kit/toolbelt" "$top/build-n4-module-kit/retros" "$TMPDIR_T/bin"
  cp "$GEN" "$top/build-n4-module-kit/toolbelt/"
  run bash "$top/build-n4-module-kit/toolbelt/gen-retro-index.sh"
  [ "$status" -eq 3 ]
  [[ "$output" == *"no Go module at $top/go"* ]]
  mkdir -p "$top/go"; printf 'module example.com/x\n' > "$top/go/go.mod"
  cp "$KIT/../go/go-tool.sh" "$top/go/"
  ln -s "$(command -v bash)" "$TMPDIR_T/bin/bash"; ln -s "$(command -v dirname)" "$TMPDIR_T/bin/dirname"; ln -s "$(command -v readlink)" "$TMPDIR_T/bin/readlink"
  run env PATH="$TMPDIR_T/bin" bash "$top/build-n4-module-kit/toolbelt/gen-retro-index.sh"
  [ "$status" -eq 3 ]
  [[ "$output" == *"go is not on PATH"* ]]
}

# _copy_top — a fake toplevel with a copy of the repository go/ (no bin/) and the wrapper, so a
# rebuild never touches the shared go/bin of the checkout.
_copy_top() {
  TOP="$TMPDIR_T/top"
  mkdir -p "$TOP/build-n4-module-kit/toolbelt"
  cp "$GEN" "$TOP/build-n4-module-kit/toolbelt/"
  cp -R "$KIT/../go" "$TOP/go"
  rm -rf "$TOP/go/bin"
  _mkretro 2026-09-01-alpha.md folded kit 0
}

@test "GRI-build: the wrapper builds a missing binary, reuses a fresh one and rebuilds after a source edit" {
  # Mutation: GT3 -- a wrapper that only tests `[ -x bin ]` never rebuilds after a source edit.
  _copy_top
  local bin="$TOP/go/bin/gen-retro-index"
  run bash "$TOP/build-n4-module-kit/toolbelt/gen-retro-index.sh" "$FK"
  [ "$status" -eq 0 ]
  [ -x "$bin" ]
  [ "$(_rows)" = "| 2026-09-01-alpha.md | kit | 2026-09-01 | folded | 0 |" ]
  touch -d '2000-01-01' "$bin"
  find "$TOP/go" -path "$TOP/go/bin" -prune -o \( -name '*.go' -o -name go.mod \) -exec touch -d '1999-06-01' {} +
  run bash "$TOP/build-n4-module-kit/toolbelt/gen-retro-index.sh" --check "$FK"
  [ "$status" -eq 0 ]
  [ "$(date -r "$bin" +%Y)" = 2000 ] # every source is older: reused, not rebuilt
  touch "$TOP/go/internal/retroindex/retroindex.go"
  run bash "$TOP/build-n4-module-kit/toolbelt/gen-retro-index.sh" --check "$FK"
  [ "$status" -eq 0 ]
  [ "$(date -r "$bin" +%Y)" != 2000 ]
}

@test "GRI-nogo-stale: a stale binary with no go on PATH is exit 3, never a run of the old binary" {
  _copy_top
  local bin="$TOP/go/bin/gen-retro-index"
  run bash "$TOP/build-n4-module-kit/toolbelt/gen-retro-index.sh" "$FK"
  [ "$status" -eq 0 ]
  touch -d '2000-01-01' "$bin"
  mkdir -p "$TMPDIR_T/bin"
  local t
  for t in bash dirname find head readlink; do ln -s "$(command -v "$t")" "$TMPDIR_T/bin/$t"; done
  run env PATH="$TMPDIR_T/bin" bash "$TOP/build-n4-module-kit/toolbelt/gen-retro-index.sh" --check "$FK"
  [ "$status" -eq 3 ]
  [[ "$output" == *"go is not on PATH"* ]]
  [[ "$output" != *"is fresh"* ]]
}
