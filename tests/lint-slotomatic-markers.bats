#!/usr/bin/env bats
# Tests for build-n4-module-kit/toolbelt/lint-slotomatic-markers.sh (kit lint G3, METHODOLOGY.md K15): a
# Slot-o-Matic region with a stamp count other than one is skipped by Slot-o-Matic while the build stays green.

setup() {
  KIT="$(cd "$BATS_TEST_DIRNAME/.." && pwd)/build-n4-module-kit"
  SM="$KIT/toolbelt/lint-slotomatic-markers.sh"
  SRC="$BATS_TEST_TMPDIR/Mod-rt/src/com/x"; mkdir -p "$SRC"
  B='//region /*+ ------------ BEGIN BAJA AUTO GENERATED CODE ------------ +*/'
  E='//endregion /*+ ------------ END BAJA AUTO GENERATED CODE -------------- +*/'
  # shellcheck disable=SC2016  # the literal Slot-o-Matic stamp text
  S='  /*@ $com.x.BLimiter(2047217791)1.0$ @*/'
}

# region <file> <line>...: a class whose body is the given lines.
region() { local f="$1"; shift; { printf 'public class X extends BComponent\n{\n'; printf '%s\n' "$@"; printf '}\n'; } > "$SRC/$f"; }

@test "SM-usage: no argument exits 3 with the usage line" {
  run "$SM"
  [ "$status" -eq 3 ]
  [[ "$output" == *"usage: lint-slotomatic-markers.sh"* ]]
}

@test "SM-empty: a root with no *.java is an ERROR, exit 3" {
  run "$SM" "$BATS_TEST_TMPDIR/none"
  [ "$status" -eq 3 ]
  mkdir -p "$BATS_TEST_TMPDIR/empty"
  run "$SM" "$BATS_TEST_TMPDIR/empty"
  [ "$status" -eq 3 ]
  [ "$output" = "ERROR  lint-slotomatic-markers  $BATS_TEST_TMPDIR/empty  no *.java sources found (wrong path or empty source tree)" ]
}

@test "SM1: an empty BEGIN/END region FAILs naming the file and the BEGIN line" {
  region BEmpty.java "$B" '//@formatter:off' '//@formatter:on' "$E"
  run "$SM" "$BATS_TEST_TMPDIR/Mod-rt/src"
  [ "$status" -eq 1 ]
  [[ "$output" == "FAIL  lint-slotomatic-markers  $SRC/BEmpty.java:3  generated region holds 0 "* ]]
}

@test "SM2: a region with two stamp lines FAILs" {
  region BTwo.java "$B" "$S" "$S" "$E"
  run "$SM" "$BATS_TEST_TMPDIR/Mod-rt/src"
  [ "$status" -eq 1 ]
  [[ "$output" == *"BTwo.java:3  generated region holds 2 "* ]]
}

@test "SM3: a region with one stamp line is clean" {
  region BOne.java "$B" "$S" '  /* Generated by Slot-o-Matic (c) Tridium, Inc. 2012-2026 */' "$E"
  run "$SM" "$BATS_TEST_TMPDIR/Mod-rt/src"
  [ "$status" -eq 0 ]
  [ -z "$output" ]
}

@test "SM4: a file with no markers at all is clean" {
  region BNone.java '  public static final Type TYPE = Sys.loadType(X.class);'
  run "$SM" "$BATS_TEST_TMPDIR/Mod-rt/src"
  [ "$status" -eq 0 ]
  [ -z "$output" ]
}

@test "SM5: marker and stamp text inside string literals is code, not a region or a stamp" {
  region BLit.java "  static final String B = \"$B\";" "  static final String E = \"$E\";"
  # shellcheck disable=SC2016  # stamp text quoted in a Java string literal
  region BStampText.java "$B" "$S" '  static final String S = "/*@ $fake$ @*/";' "$E"
  run "$SM" "$BATS_TEST_TMPDIR/Mod-rt/src"
  [ "$status" -eq 0 ]
  [ -z "$output" ]
}

@test "SM6: a BEGIN with no END WARNs unclosed-region, exit 0; --strict exits 1" {
  region BOpen.java "$B" "$S"
  run "$SM" "$BATS_TEST_TMPDIR/Mod-rt/src"
  [ "$status" -eq 0 ]
  [[ "$output" == "WARN  unclosed-region  $SRC/BOpen.java:3  "* ]]
  run "$SM" --strict "$BATS_TEST_TMPDIR/Mod-rt/src"
  [ "$status" -eq 1 ]
}

@test "SM7: a @NiagaraType class with a hand-written TYPE beside its region FAILs type-outside-region" {
  { printf '@NiagaraType\npublic class BDemo extends BComponent\n{\n'
    printf '%s\n' "$B" "$S" '  public Type getType() { return TYPE; }' \
      '  public static final Type TYPE = Sys.loadType(BDemo.class);' "$E" \
      '  public static final Type TYPE = Sys.loadType(BDemo.class);'
    printf '}\n'; } > "$SRC/BDemo.java"
  run "$SM" "$BATS_TEST_TMPDIR/Mod-rt/src"
  [ "$status" -eq 1 ]
  [[ "$output" == "FAIL  type-outside-region  $SRC/BDemo.java:9  hand-written TYPE outside the generated region of BDemo: "* ]]
}

@test "SM8: TYPE and getType() only inside the region, or a class with no region, are clean" {
  { printf '@NiagaraType\npublic class BDemo extends BComponent\n{\n'
    printf '%s\n' "$B" "$S" '  public Type getType() { return TYPE; }' \
      '  public static final Type TYPE = Sys.loadType(BDemo.class);' "$E"
    printf '}\n'; } > "$SRC/BDemo.java"
  { printf '@NiagaraType\npublic class BLab extends BComponent\n{\n'
    printf '%s\n' '  public static final Type TYPE = Sys.loadType(BLab.class);' '  public Type getType() { return TYPE; }'
    printf '}\n'; } > "$SRC/BLab.java"
  run "$SM" "$BATS_TEST_TMPDIR/Mod-rt/src"
  [ "$status" -eq 0 ]
  [ -z "$output" ]
}

@test "SM9: a multi-line // comment above @NiagaraProperty whose last line continues the line above WARNs slotomatic-doc-line" {
  # Slot-o-Matic keeps only the LAST comment line as the slot's Javadoc (the 2026-09-24 phase-2 alarms retro, Δ7).
  { printf '@NiagaraType\n'
    printf '%s\n' '// Over-amperage limit shared by all 3' '// compressors. 0 (default) = disabled.' \
      '@NiagaraProperty(name = "overAmpsLimit", type = "double", defaultValue = "0")' \
      '// Rationale first.' '// Suction low limit in psig; 0 disables it.' \
      '@NiagaraProperty(name = "suctionLowLimit", type = "double", defaultValue = "0")' \
      'public class BPanel extends BComponent' '{' '}'; } > "$SRC/BPanel.java"
  run "$SM" "$BATS_TEST_TMPDIR/Mod-rt/src"
  [ "$status" -eq 0 ]
  [ "$output" = "WARN  slotomatic-doc-line  $SRC/BPanel.java:3  the last line of the // comment above @NiagaraProperty continues the line before it: Slot-o-Matic keeps only that line for the generated Javadoc -- make it a complete sentence (types/logic-authoring.md)" ]
  run "$SM" --strict "$BATS_TEST_TMPDIR/Mod-rt/src"
  [ "$status" -eq 1 ]
}
