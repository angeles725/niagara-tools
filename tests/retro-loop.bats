#!/usr/bin/env bats
# RED-FIRST pins for the retro/ticket loop (campaign 8 PR16, wave3 D13/R16). Content shape from
# companero's draft (niagara-research sources/probes/2026-09-05-c8-pr16-retro-loop-draft.md).
#
#   new-retro.sh <module|kit> <slug>  atomically writes retros/<date>-<slug>.md (stub: the header
#     block review-status/module/deltas on lines 1-3, 4 sections, Delta count) + REGENERATES
#     retros/INDEX.md with toolbelt/gen-retro-index.sh (r8 T8i: the index is generated from the retro
#     headers, never appended to) + sets retro_pending: true in BUILD-STATE.src.md (the committed source
#     of the generated BUILD-STATE.md; R10-D1, neither generated file is committed). Idempotent: a second
#     run with the same slug refuses (file exists) and the index keeps one row per retro.
#   kit-ticket.sh "<one-line>"  opens a kit issue, or writes retros/tickets/<date>-<slug>.md offline
#     (gh absent/unauthenticated) with a SKIP row and exit 0 — never exit 1 for missing gh.
#
# The scripts write to the kit at $KIT (or cwd); the tests run them via `env -C <tmpkit> KIT=<tmpkit>`
# so they never touch the real kit (a testable-seam requirement for the apply worker to honor).
#
# RED today: new-retro.sh / kit-ticket.sh do not exist -> every pin fails for the right reason (absent).
# NAMED MUTATION (R16.6): append an INDEX row instead of regenerating -> RL9 sees a second row for a
#   pre-seeded stale row, and RL6 misses the GENERATED first line.

# RL4 runs kit-ticket.sh (a wrapper over go/bin/kit-ticket) under a PATH without go: build the binary here,
# with the full PATH, through the same go_tool_bin the wrapper calls, so RL4 only needs it to be current.
setup_file() {
  # shellcheck disable=SC1091  # go/ helper of this repository
  . "$BATS_TEST_DIRNAME/../go/go-tool.sh"
  go_tool_bin "$BATS_TEST_DIRNAME/../go" kit-ticket >/dev/null
}

setup() {
  KIT="$(cd "$BATS_TEST_DIRNAME/.." && pwd)/build-n4-module-kit"
  NR="$KIT/toolbelt/new-retro.sh"; KT="$KIT/toolbelt/kit-ticket.sh"
  TK="$BATS_TEST_TMPDIR/kit"; mkdir -p "$TK/retros"
  printf '| Retro file | Module | Date | review-status | deltas |\n|---|---|---|---|---|\n' > "$TK/retros/INDEX.md"
  printf '<!-- build-state.v1 -->\n## kit\nretro_required: true\nretro_pending: false\n' > "$TK/BUILD-STATE.src.md"
  DATE="$(date +%Y-%m-%d)"
}
nr() { run env -C "$TK" KIT="$TK" "$NR" "$@"; }
kt() { run env -C "$TK" KIT="$TK" "$@"; }   # first vararg is the command (for PATH control)

@test "RL1: new-retro.sh writes the stub — line 1 EXACTLY the marker + the 4 sections" {
  nr kit rl1slug
  [ "$status" -eq 0 ]
  F="$TK/retros/$DATE-rl1slug.md"
  [ -f "$F" ]
  [ "$(head -1 "$F")" = "<!-- review-status: pending -->" ]
  [ "$(sed -n 2p "$F")" = "<!-- module: kit -->" ]
  [ "$(sed -n 3p "$F")" = "<!-- deltas: 0 -->" ]
  grep -qiE 'what happened' "$F"
  grep -qiE 'evidence' "$F"
  grep -qiE 'proposed kit deltas' "$F" && grep -qiE 'lessons' "$F"
}

@test "RL2: a second run with the same slug does NOT duplicate the INDEX row (idempotent guard)" {
  nr kit rl2slug
  nr kit rl2slug
  [ "$(grep -c 'rl2slug' "$TK/retros/INDEX.md")" -eq 1 ]
}

@test "RL3: the BUILD-STATE.src.md kit envelope flips retro_pending to true" {
  nr kit rl3slug
  grep -qE 'retro_pending:[[:space:]]*true' "$TK/BUILD-STATE.src.md"
}

@test "RL4: kit-ticket.sh with gh ABSENT -> exit 0, SKIP row, writes the offline fallback file" {
  NOGH="$TK/nogh"; mkdir -p "$NOGH"
  # find and readlink: the wrapper resolves itself and checks go/bin/kit-ticket is current (go_tool_bin); no gh.
  for t in bash sh env grep sed awk cat date dirname basename mkdir printf find readlink; do
    p="$(command -v "$t" 2>/dev/null)"; [ -n "$p" ] && ln -sf "$p" "$NOGH/"
  done
  run env -C "$TK" KIT="$TK" PATH="$NOGH" bash "$KT" "fix the timer leak"
  [ "$status" -eq 0 ]
  [[ "$output" == *"SKIP"* ]]
  ls "$TK"/retros/tickets/"$DATE"-*.md >/dev/null 2>&1
}

@test "RL5: Delta count in the stub == the deltas header == the INDEX deltas column == the deltas table row count" {
  nr kit rl5slug --deltas 3
  [ "$status" -eq 0 ]
  F="$TK/retros/$DATE-rl5slug.md"
  dc=$(grep -oiE 'Delta count[^0-9]*[0-9]+' "$F" | grep -oE '[0-9]+' | head -1)
  hdr=$(sed -n 's/^<!-- deltas: \([0-9]*\) -->$/\1/p' "$F")
  idx=$(grep 'rl5slug' "$TK/retros/INDEX.md" | awk -F'|' '{gsub(/ /,"",$6); print $6}')
  rows=$(grep -cE '^\| Δ[0-9]+ \|' "$F")
  [ "$dc" = 3 ] && [ "$hdr" = 3 ] && [ "$idx" = 3 ] && [ "$rows" = 3 ]
}

@test "RL6: the regenerated INDEX row matches the fixed column format and the index is fresh" {
  nr kit rl6slug
  [ "$status" -eq 0 ]
  [[ "$output" =~ index[[:space:]]+PASS.*regenerated ]]
  head -1 "$TK/retros/INDEX.md" | grep -qxF '<!-- GENERATED by kit-state from ledger.d/ and retros/ — do not edit; regenerated on pull -->'
  bash "$KIT/toolbelt/gen-retro-index.sh" --check "$TK"
  grep -qE "^\|[[:space:]]*${DATE}-rl6slug\.md[[:space:]]*\|[[:space:]]*kit[[:space:]]*\|[[:space:]]*${DATE}[[:space:]]*\|[[:space:]]*pending[[:space:]]*\|[[:space:]]*[0-9]+[[:space:]]*\|" "$TK/retros/INDEX.md"
}

@test "RL7: retro_pending flip is scoped to the named section; other sections stay false" {
  # 3-section BUILD-STATE fixture — all retro_pending: false
  _bs_fixture="<!-- build-state.v1 -->
module: kit
retro_required: true
retro_pending: false
<!-- /build-state.v1 -->
<!-- build-state.v1 -->
module: ModuleA
retro_required: true
retro_pending: false
<!-- /build-state.v1 -->
<!-- build-state.v1 -->
module: ModuleB
retro_required: true
retro_pending: false
<!-- /build-state.v1 -->"
  # helper: extract retro_pending value for a given module name
  _pend() { local mod="$1" f="$2"
    awk -v m="$mod" '/^<!-- build-state\.v1 -->$/{s=1;hit=0;next} /^<!-- \/build-state\.v1 -->$/{s=0;next} s&&/^module:/{v=$0;sub(/^module:[[:space:]]*/,"",v);sub(/[[:space:]]*#.*$/,"",v);sub(/[[:space:]]+$/,"",v);if(v==m)hit=1} s&&hit&&/^retro_pending:/{v=$0;sub(/^retro_pending:[[:space:]]*/,"",v);sub(/[[:space:]]*#.*$/,"",v);sub(/[[:space:]]+$/,"",v);print v;hit=0}' "$f"
  }

  # Case 1: new-retro.sh kit <slug> → kit section flips; ModuleA + ModuleB stay false
  TK1="$BATS_TEST_TMPDIR/rl7kit"; mkdir -p "$TK1/retros"
  printf '| Retro file | Module | Date | review-status | deltas |\n|---|---|---|---|---|\n' > "$TK1/retros/INDEX.md"
  printf '%s\n' "$_bs_fixture" > "$TK1/BUILD-STATE.src.md"
  run env -C "$TK1" KIT="$TK1" "$NR" kit rl7-kit-slug
  [ "$status" -eq 0 ]
  [ "$(_pend kit "$TK1/BUILD-STATE.src.md")" = "true" ]
  [ "$(_pend ModuleA "$TK1/BUILD-STATE.src.md")" = "false" ]
  [ "$(_pend ModuleB "$TK1/BUILD-STATE.src.md")" = "false" ]

  # Case 2 (symmetric): new-retro.sh ModuleA <slug> → ModuleA flips; kit + ModuleB stay false
  TK2="$BATS_TEST_TMPDIR/rl7crp"; mkdir -p "$TK2/retros"
  printf '| Retro file | Module | Date | review-status | deltas |\n|---|---|---|---|---|\n' > "$TK2/retros/INDEX.md"
  printf '%s\n' "$_bs_fixture" > "$TK2/BUILD-STATE.src.md"
  run env -C "$TK2" KIT="$TK2" "$NR" ModuleA rl7-crp-slug
  [ "$status" -eq 0 ]
  [ "$(_pend kit "$TK2/BUILD-STATE.src.md")" = "false" ]
  [ "$(_pend ModuleA "$TK2/BUILD-STATE.src.md")" = "true" ]
  [ "$(_pend ModuleB "$TK2/BUILD-STATE.src.md")" = "false" ]
}

@test "RL8: slug shorter than 6 chars is rejected with exit 3; exactly 6 chars is accepted" {
  # 5-char slug must fail (sweep-fold-audit.sh drops tokens < 6 chars, making retros unfoldable)
  run env -C "$TK" KIT="$TK" "$NR" kit abcde
  [ "$status" -eq 3 ]
  [[ "$output" =~ "slug must be" ]]
  # 6-char slug must succeed
  run env -C "$TK" KIT="$TK" "$NR" kit abcdef
  [ "$status" -eq 0 ]
}

@test "RL9: a pre-seeded INDEX row for an absent retro is not duplicated — the index is regenerated" {
  # Fixture: retro file ABSENT, INDEX row PRE-SEEDED for the same slug
  TK9="$BATS_TEST_TMPDIR/rl9kit"; mkdir -p "$TK9/retros"
  printf '| Retro file | Module | Date | review-status | deltas |\n|---|---|---|---|---|\n' > "$TK9/retros/INDEX.md"
  printf '| %s-rl9slug.md | kit | %s | pending | 0 |\n' "$DATE" "$DATE" >> "$TK9/retros/INDEX.md"
  printf '<!-- build-state.v1 -->\n## kit\nretro_required: true\nretro_pending: false\n' > "$TK9/BUILD-STATE.src.md"
  # Retro file must not exist (primary guard cannot fire; secondary INDEX guard must carry it)
  [ ! -f "$TK9/retros/$DATE-rl9slug.md" ]
  run env -C "$TK9" KIT="$TK9" "$NR" kit rl9slug
  [ "$status" -eq 0 ]
  # Stub must be written
  [ -f "$TK9/retros/$DATE-rl9slug.md" ]
  # The index is regenerated from the retro headers (no append, so no duplicate guard is needed)
  [[ "$output" =~ index[[:space:]]+PASS.*regenerated ]]
  # Envelope must flip
  grep -q 'retro_pending: true' "$TK9/BUILD-STATE.src.md"
  # INDEX must still have exactly ONE row for rl9slug (no duplicate)
  [ "$(grep -c 'rl9slug' "$TK9/retros/INDEX.md")" -eq 1 ]
}

@test "RL10: a generator failure lands nothing — no stub left behind, INDEX and BUILD-STATE unchanged" {
  # Another retro in the dir has no module/deltas headers, so gen-retro-index.sh exits 1.
  printf '<!-- review-status: pending -->\n# legacy\n' > "$TK/retros/2026-01-01-legacy.md"
  cp "$TK/retros/INDEX.md" "$BATS_TEST_TMPDIR/index.before"
  cp "$TK/BUILD-STATE.src.md" "$BATS_TEST_TMPDIR/state.before"
  nr kit rl10slug
  [ "$status" -eq 1 ]
  [[ "$output" == *"2026-01-01-legacy.md"* ]]
  [ ! -f "$TK/retros/$DATE-rl10slug.md" ]
  cmp -s "$BATS_TEST_TMPDIR/index.before" "$TK/retros/INDEX.md"
  cmp -s "$BATS_TEST_TMPDIR/state.before" "$TK/BUILD-STATE.src.md"
}

@test "RL11: no INDEX.md beforehand (it is generated, not committed) -> the stub lands and the index is generated" {
  rm "$TK/retros/INDEX.md"
  nr kit rl11slug
  [ "$status" -eq 0 ]
  grep -qF "| $DATE-rl11slug.md | kit | $DATE | pending | 0 |" "$TK/retros/INDEX.md"
  grep -q 'retro_pending: true' "$TK/BUILD-STATE.src.md"
}

# retro deltas 1928: gh PRESENT but with no known host / no auth must not just fail (exit 3, ticket lost) —
# the body is kept as a local ticket file, the path is printed and the exit status is the distinct 4.
_stub_gh() {  # _stub_gh <stderr text> : gh issue create fails with that text
  GHBIN="$BATS_TEST_TMPDIR/ghbin"; mkdir -p "$GHBIN"
  printf '#!/usr/bin/env bash\nprintf "%%s\\n" "%s" >&2\nexit 1\n' "$1" > "$GHBIN/gh"
  chmod +x "$GHBIN/gh"
}

@test "RL4b: gh present but 'no known GitHub host' -> local ticket file, path printed, exit 4 (never 0, never lost)" {
  # Mutation: RL4b -- removing the host/auth fallback branch returns the generic exit 3 and writes no file.
  _stub_gh "gh: no known GitHub host"
  run env -C "$TK" KIT="$TK" PATH="$GHBIN:$PATH" bash "$KT" "fix the host fallback"
  [ "$status" -eq 4 ]
  [[ "$output" == *"LOCAL"* ]]
  [[ "$output" == *"retros/tickets/$DATE-fix-the-host-fallback.md"* ]]
  F="$TK/retros/tickets/$DATE-fix-the-host-fallback.md"
  [ -f "$F" ]
  grep -q '^\[kit\] fix the host fallback' "$F"
}

@test "RL4b2: gh 'none of the git remotes ... point to a known GitHub host' -> local fallback, exit 4" {
  _stub_gh "none of the git remotes configured for this repository point to a known GitHub host"
  run env -C "$TK" KIT="$TK" PATH="$GHBIN:$PATH" bash "$KT" "fix the remotes fallback"
  [ "$status" -eq 4 ]
  [ -f "$TK/retros/tickets/$DATE-fix-the-remotes-fallback.md" ]
}

@test "RL4c: gh present, not logged in ('gh auth login') -> same local fallback, exit 4" {
  _stub_gh "To get started with GitHub CLI, please run:  gh auth login"
  run env -C "$TK" KIT="$TK" PATH="$GHBIN:$PATH" bash "$KT" "fix the auth fallback"
  [ "$status" -eq 4 ]
  [ -f "$TK/retros/tickets/$DATE-fix-the-auth-fallback.md" ]
}

@test "RL4c2: gh 'You are not logged in' -> local fallback, exit 4" {
  _stub_gh "You are not logged into any GitHub hosts."
  run env -C "$TK" KIT="$TK" PATH="$GHBIN:$PATH" bash "$KT" "fix the notlogged fallback"
  [ "$status" -eq 4 ]
  [ -f "$TK/retros/tickets/$DATE-fix-the-notlogged-fallback.md" ]
}

@test "RL4e: gh run outside a git repository (no --repo) -> local fallback, exit 4, path printed" {
  # Mutation: RL4e -- dropping the 'not a git repository' alternative loses it to exit 3.
  _stub_gh "fatal: not a git repository (or any of the parent directories): .git"
  run env -C "$TK" KIT="$TK" PATH="$GHBIN:$PATH" bash "$KT" "fix the norepo fallback"
  [ "$status" -eq 4 ]
  [[ "$output" == *"retros/tickets/$DATE-fix-the-norepo-fallback.md"* ]]
  [ -f "$TK/retros/tickets/$DATE-fix-the-norepo-fallback.md" ]
}

@test "RL4f: gh 'could not determine base repo' -> local fallback, exit 4" {
  _stub_gh "could not determine base repo"
  run env -C "$TK" KIT="$TK" PATH="$GHBIN:$PATH" bash "$KT" "fix the baserepo fallback"
  [ "$status" -eq 4 ]
  [ -f "$TK/retros/tickets/$DATE-fix-the-baserepo-fallback.md" ]
}

@test "RL4d: any OTHER gh failure keeps the ticket file too but stays exit 3 (distinct from 4), path printed" {
  # Mutation: RL4d -- deleting the body on failure (the old rm) loses the ticket.
  _stub_gh "HTTP 502: bad gateway"
  run env -C "$TK" KIT="$TK" PATH="$GHBIN:$PATH" bash "$KT" "fix the other failure"
  [ "$status" -eq 3 ]
  [[ "$output" == *"retros/tickets/$DATE-fix-the-other-failure.md"* ]]
  [ -f "$TK/retros/tickets/$DATE-fix-the-other-failure.md" ]
}
