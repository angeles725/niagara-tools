#!/usr/bin/env bats
# kit-state.bats — toolbelt/kit-state.sh, the ONE reader command for the kit's generated state, and the
# doc pin that every reader path uses it. BUILD-STATE.md and retros/INDEX.md are generated from the
# committed BUILD-STATE.src.md + ledger.d/ + retros/ and are NOT committed (R10-D1), so a reader that
# opens either file in a checkout reads nothing, or a stale local copy. [ev: retro ledger-generated-not-committed]

GENERATED='<!-- GENERATED by kit-state from ledger.d/ and retros/ — do not edit; regenerated on pull -->'

setup() {
  REPO="$(cd "$BATS_TEST_DIRNAME/.." && pwd)"
  KIT="$REPO/build-n4-module-kit"
  KS="$KIT/toolbelt/kit-state.sh"
}

# _copy_kit — a temp kit with the real sources and the wrapper, so --write never touches the checkout.
_copy_kit() {
  TOP="$BATS_TEST_TMPDIR/top"; TK="$TOP/build-n4-module-kit"
  mkdir -p "$TK/toolbelt" "$TK/retros"
  ln -s "$REPO/go" "$TOP/go"
  cp "$KIT/BUILD-STATE.src.md" "$TK/"
  cp -R "$KIT/ledger.d" "$TK/"
  cp "$KIT"/retros/*.md "$TK/retros/"
  rm -f "$TK/retros/INDEX.md"
  cp "$KS" "$TK/toolbelt/"
}

@test "KS1: build-state prints the generated ledger of the real kit (GENERATED line, module and kit envelopes)" {
  run bash "$KS" build-state
  [ "$status" -eq 0 ]
  [ "${lines[0]}" = "$GENERATED" ]
  [ "$(grep -c '^module: ' <<<"$output")" -ge 2 ]   # a hand-kept module envelope besides the kit block
  [[ "$output" == *$'\nmodule: kit '* ]]
  [[ "$output" != *"last_change: generated"* ]]
}

@test "KS2: retro-index prints one row per committed retro" {
  run bash "$KS" retro-index
  [ "$status" -eq 0 ]
  [ "${lines[0]}" = "$GENERATED" ]
  n=$(find "$KIT/retros" -maxdepth 1 -name '*.md' ! -name INDEX.md | wc -l)
  [ "$(printf '%s\n' "$output" | grep -cE '^\| [^ ]+\.md \|')" -eq "$n" ]
}

@test "KS3: --write materializes both files in the kit, prints each path, and equals the printed form" {
  _copy_kit
  run bash "$TK/toolbelt/kit-state.sh" --write
  [ "$status" -eq 0 ]
  [ "${lines[0]}" = "kit-state: wrote $TK/BUILD-STATE.md" ]
  [ "${lines[1]}" = "kit-state: wrote $TK/retros/INDEX.md" ]
  bash "$TK/toolbelt/kit-state.sh" build-state | cmp - "$TK/BUILD-STATE.md"
  bash "$TK/toolbelt/kit-state.sh" retro-index | cmp - "$TK/retros/INDEX.md"
}

@test "KS4: a malformed fragment is exit 1 and writes neither file" {
  _copy_kit
  printf '<!-- ledger: kit -->\n  - hand item\n' > "$TK/ledger.d/2099-01-01-bad.md"
  run bash "$TK/toolbelt/kit-state.sh" --write
  [ "$status" -eq 1 ]
  [[ "$output" == *"2099-01-01-bad.md"* ]]
  [ ! -e "$TK/BUILD-STATE.md" ] && [ ! -e "$TK/retros/INDEX.md" ]
}

@test "KS5: no view and no --write, or an unknown flag, is a usage error (exit 3)" {
  run bash "$KS"
  [ "$status" -eq 3 ]
  [[ "$output" == *"usage: kit-state.sh"* ]]
  run bash "$KS" --bogus build-state
  [ "$status" -eq 3 ]
}
