#!/usr/bin/env bats
# Tests for build-n4-module-kit/toolbelt/gen-build-state.sh — BUILD-STATE.md generated from the committed
# BUILD-STATE.src.md + ledger.d/. Every kit PR used to edit the same `last_change:` line, prepend
# `open_issues:` items at the same spot and append a session-log line at the same spot; then each change
# added one ledger.d/ fragment but the regenerated BUILD-STATE.md was still committed, so parallel PRs
# still conflicted on it. Now the file is not committed: the source keeps every hand-kept field with the
# kit envelope's generated parts empty, and --check validates the inputs (fails closed).
# Exits: 0 written / inputs valid · 1 ledger fragment or BUILD-STATE.src.md violation · 3 usage/env.
# [ev: retro ledger-fragments] [ev: retro ledger-generated-not-committed]

setup() {
  KIT="$(cd "$BATS_TEST_DIRNAME/.." && pwd)/build-n4-module-kit"
  GEN="$KIT/toolbelt/gen-build-state.sh"
  SWEEP="$KIT/toolbelt/sweep-build-state.sh"
  FIX="$(cd "$BATS_TEST_DIRNAME" && pwd)/fixtures/gen-build-state"
  FK="$BATS_TEST_TMPDIR/kit"
  mkdir -p "$FK/retros"
  cp "$FIX/BUILD-STATE.src.md" "$FK/"
  cp -R "$FIX/ledger.d" "$FK/"
}

_frag() { # _frag <file> <date> <log text> [open_issue text]
  {
    printf '<!-- ledger: kit -->\n<!-- date: %s -->\n<!-- last-change-note: %s note -->\n' "$2" "$1"
    printf 'log: %s · %s\n' "$2" "$3"
    [ -z "${4:-}" ] || printf 'open_issue: %s\n' "$4"
  } > "$FK/ledger.d/$1"
}

@test "GBS-usage: an unknown flag or extra args exit 3" {
  run bash "$GEN" --bogus "$FK"
  [ "$status" -eq 3 ]
  run bash "$GEN" "$FK" "$FK"
  [ "$status" -eq 3 ]
  run bash "$GEN" "$BATS_TEST_TMPDIR/nope"
  [ "$status" -eq 3 ]
}

@test "GBS-real: the committed BUILD-STATE.src.md and ledger.d/ are valid" {
  run bash "$GEN" --check
  [ "$status" -eq 0 ]
  [[ "$output" == *"BUILD-STATE.src.md and ledger.d/ are valid"* ]]
}

@test "GBS-fixture: the archive-only fixture generates the expected BUILD-STATE.md byte for byte" {
  run bash "$GEN" --check "$FK"
  [ "$status" -eq 0 ]
  [ ! -e "$FK/BUILD-STATE.md" ]
  run bash "$GEN" "$FK"
  [ "$status" -eq 0 ]
  cmp "$FIX/BUILD-STATE.expected.md" "$FK/BUILD-STATE.md"
  cmp "$FIX/BUILD-STATE.src.md" "$FK/BUILD-STATE.src.md"
}

@test "GBS-new: a new fragment appends its log line and prepends its issue on the next generation" {
  bash "$GEN" "$FK" >/dev/null
  _frag 2026-10-24-new.md 2026-10-24 "new change" "OWED new half"
  run bash "$GEN" "$FK"
  [ "$status" -eq 0 ]
  head -1 "$FK/BUILD-STATE.md" | grep -qxF '<!-- GENERATED by kit-state from ledger.d/ and retros/ — do not edit; regenerated on pull -->'
  grep -qxF 'last_change: 2026-10-24              # 2026-10-24-new.md note' "$FK/BUILD-STATE.md"
  [ "$(grep -A1 -xF 'open_issues:' "$FK/BUILD-STATE.md" | tail -1)" = "  - OWED new half" ]
  [ "$(grep -B1 -xF '<!-- /build-state.v1 -->' "$FK/BUILD-STATE.md" | tail -2 | head -1)" = "2026-10-24 · new change" ]
}

@test "GBS-source: a generated line pasted into BUILD-STATE.src.md is exit 1 under --check; nothing is written" {
  # Mutation: GBS-source -- without the source-form check the pasted line is dropped on every generation.
  sed -i 's/^open_issues:$/open_issues:\n  - pasted by hand/' "$FK/BUILD-STATE.src.md"
  grep -qxF '  - pasted by hand' "$FK/BUILD-STATE.src.md"
  run bash "$GEN" --check "$FK"
  [ "$status" -eq 1 ]
  [[ "$output" == *"BUILD-STATE.src.md holds generated content"* ]]
  run bash "$GEN" "$FK"
  [ "$status" -eq 1 ]
  [ ! -e "$FK/BUILD-STATE.md" ]
}

@test "GBS-malformed: a malformed fragment is exit 1 naming the file and line; nothing is written" {
  printf '<!-- ledger: kit -->\n<!-- date: 2026-10-24 -->\nlog: 2026-10-24 · x\n  - hand item\n' > "$FK/ledger.d/2026-10-24-bad.md"
  run bash "$GEN" --check "$FK"
  [ "$status" -eq 1 ]
  [[ "$output" == *"2026-10-24-bad.md: line 4:"* ]]
  run bash "$GEN" "$FK"
  [ "$status" -eq 1 ]
  [ ! -e "$FK/BUILD-STATE.md" ]
}

@test "GBS-sweep: sweep-build-state fails on a generated BUILD-STATE.md that is stale vs ledger.d/" {
  printf '| Retro file | review-status |\n|---|---|\n' > "$FK/retros/INDEX.md"
  bash "$GEN" "$FK" >/dev/null
  run bash "$SWEEP" "$FK/BUILD-STATE.md" "$FK/retros" "$FK/retros/INDEX.md"
  [ "$status" -eq 0 ]
  _frag 2026-10-24-new.md 2026-10-24 "new change"
  run bash "$SWEEP" "$FK/BUILD-STATE.md" "$FK/retros" "$FK/retros/INDEX.md"
  [ "$status" -eq 1 ]
  [[ "$output" == *"stale vs ledger.d/ and BUILD-STATE.src.md"* ]]
}
