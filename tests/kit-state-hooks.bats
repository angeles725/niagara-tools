#!/usr/bin/env bats
# kit-state-hooks.bats — .githooks/post-merge, post-checkout and post-rewrite keep the generated kit
# state (BUILD-STATE.md, retros/INDEX.md, toolbelt/INDEX.md; not committed since R10-D1) fresh in every clone that runs
# scripts/install-hooks.sh: after a pull, a checkout or a rebase/amend, `kit-state --write` runs. They
# never block git: exit 0 always; when generation fails they print ONE named warning line and delete
# both generated files, so no reader is left with stale data. [ev: retro ledger-generated-not-committed]
#
# git is REAL here, on throwaway repos: an "origin" with the kit layout (real sources, real hooks and
# kit-state wrapper, go/ symlinked to this repo's Go module) and a clone with the hooks active.

WARN='kit-state: could not regenerate BUILD-STATE.md/retros/INDEX.md/toolbelt/INDEX.md ('

setup() {
  REPO="$(cd "$BATS_TEST_DIRNAME/.." && pwd)"
  KIT="$REPO/build-n4-module-kit"
  O="$BATS_TEST_TMPDIR/origin"; C="$BATS_TEST_TMPDIR/clone"
  mkdir -p "$O/build-n4-module-kit/toolbelt" "$O/build-n4-module-kit/retros"
  cp -R "$REPO/.githooks" "$O/"
  cp "$REPO/.gitignore" "$O/"
  ln -s "$REPO/go" "$O/go"
  cp "$KIT/BUILD-STATE.src.md" "$O/build-n4-module-kit/"
  cp -R "$KIT/ledger.d" "$O/build-n4-module-kit/"
  cp "$KIT"/retros/*.md "$O/build-n4-module-kit/retros/"
  rm -f "$O/build-n4-module-kit/retros/INDEX.md"
  cp "$KIT/toolbelt/kit-state.sh" "$O/build-n4-module-kit/toolbelt/"
  g "$O" init -q -b main
  g "$O" add -A
  g "$O" commit -qm base
  git clone -q "$O" "$C"
  g "$C" config core.hooksPath .githooks
}

g() { local d="$1"; shift; git -C "$d" -c user.name=t -c user.email=t@example.com -c commit.gpgsign=false "$@"; }

# frag <repo> <slug> [body]: add a ledger fragment dated 2099-01-01 (a malformed one with a body).
frag() {
  printf '%s\n' "${3:-<!-- ledger: kit -->
<!-- date: 2099-01-01 -->
log: 2099-01-01 · $2 landed}" > "$1/build-n4-module-kit/ledger.d/2099-01-01-$2.md"
}

@test "HK1: a pull that brings a new ledger fragment regenerates BUILD-STATE.md without a manual run" {
  # Mutation: HK1 -- an empty post-merge (or no hook) leaves the clone without the new log line.
  frag "$O" pulled-change
  g "$O" add -A; g "$O" commit -qm "feat: pulled change"
  run g "$C" pull -q --no-rebase origin main
  [ "$status" -eq 0 ]
  grep -qF '2099-01-01 · pulled-change landed' "$C/build-n4-module-kit/BUILD-STATE.md"
  head -1 "$C/build-n4-module-kit/retros/INDEX.md" | grep -qF '<!-- GENERATED by kit-state'
  head -1 "$C/build-n4-module-kit/toolbelt/INDEX.md" | grep -qF '<!-- GENERATED by toolbelt/gen-lint-index.sh'
  [ -z "$(g "$C" status --porcelain)" ]
}

@test "HK2: a generator failure prints one named warning, removes both files and exits 0" {
  bash "$C/build-n4-module-kit/toolbelt/kit-state.sh" --write >/dev/null
  [ -f "$C/build-n4-module-kit/BUILD-STATE.md" ]
  frag "$O" broken '<!-- ledger: kit -->
  - hand item'
  g "$O" add -A; g "$O" commit -qm "feat: broken fragment"
  run g "$C" pull -q --no-rebase origin main
  [ "$status" -eq 0 ]
  [ "$(printf '%s\n' "$output" | grep -cF "$WARN")" -eq 1 ]
  [[ "$output" == *"$WARN"*") — generated files removed"* ]]
  [ ! -e "$C/build-n4-module-kit/BUILD-STATE.md" ] && [ ! -e "$C/build-n4-module-kit/retros/INDEX.md" ]
  [ ! -e "$C/build-n4-module-kit/toolbelt/INDEX.md" ]
  run env -C "$C" bash .githooks/post-merge
  [ "$status" -eq 0 ]
}

@test "HK3: switching to a branch with another fragment regenerates (post-checkout)" {
  g "$C" checkout -q -b side
  frag "$C" side-change
  g "$C" add -A; g "$C" commit -qm "feat: side"
  g "$C" checkout -q main
  run grep -qF 'side-change landed' "$C/build-n4-module-kit/BUILD-STATE.md"
  [ "$status" -eq 1 ]
  g "$C" checkout -q side
  grep -qF '2099-01-01 · side-change landed' "$C/build-n4-module-kit/BUILD-STATE.md"
}

@test "HK4: an amend that adds a fragment regenerates (post-rewrite)" {
  frag "$C" amended-change
  g "$C" add -A
  g "$C" commit -q --amend --no-edit
  grep -qF '2099-01-01 · amended-change landed' "$C/build-n4-module-kit/BUILD-STATE.md"
}

@test "HK5: a checkout without toolbelt/kit-state.sh (before R10-D1) is a silent no-op, exit 0" {
  rm "$C/build-n4-module-kit/toolbelt/kit-state.sh"
  for h in post-merge post-checkout post-rewrite; do
    run env -C "$C" bash ".githooks/$h" </dev/null
    [ "$status" -eq 0 ]
    [ -z "$output" ]
  done
}
