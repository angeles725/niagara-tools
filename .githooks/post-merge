#!/usr/bin/env bash
# post-merge — regenerate the kit's generated state after a merge or pull (R10-D1).
#
# BUILD-STATE.md, retros/INDEX.md and toolbelt/INDEX.md are generated by toolbelt/kit-state.sh from the
# committed BUILD-STATE.src.md, ledger.d/, retros/ and toolbelt/lint-*.sh headers, and are NOT committed
# (.gitignore), so a pull that brings a new fragment, retro or lint would leave a stale local copy. This hook (and post-checkout /
# post-rewrite / post-commit, which run it) runs `kit-state --write` after every merge, checkout,
# rebase/amend and commit.
# It NEVER blocks git: exit 0 always. Quiet on success (one "kit-state: rebuilding…" line when a Go
# source changed and the binary is rebuilt). On a failure it prints ONE named warning line
# and deletes all three generated files, so no reader is left with stale data.
# Activated with scripts/install-hooks.sh (core.hooksPath .githooks). [ev: retro ledger-generated-not-committed]
set -u

toplevel=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
kit="$toplevel/build-n4-module-kit"
[ -f "$kit/toolbelt/kit-state.sh" ] || exit 0   # a checkout from before kit-state: nothing to generate

# A pull or checkout that changed go/*.go rebuilds kit-state on demand (go/go-tool.sh). Never let that
# build fetch a Go toolchain (GOTOOLCHAIN=local), and say it is building: its own stderr is captured below,
# so the announcement goes to the hook's stderr through fd 3.
export GOTOOLCHAIN=local GO_TOOL_ANNOUNCE_FD=3
exec 3>&2

if ! err=$(bash "$kit/toolbelt/kit-state.sh" --write "$kit" 2>&1 >/dev/null); then
  rm -f "$kit/BUILD-STATE.md" "$kit/retros/INDEX.md" "$kit/toolbelt/INDEX.md"
  reason=$(grep -m1 . <<<"$err" || true)   # a here-string: no printf to break the pipe of
  printf 'kit-state: could not regenerate BUILD-STATE.md/retros/INDEX.md/toolbelt/INDEX.md (%s) — generated files removed\n' \
    "${reason:-kit-state --write failed}" >&2
fi
exit 0
