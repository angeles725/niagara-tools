#!/usr/bin/env bash
# post-merge — regenerate the kit's generated state after a merge or pull (R10-D1).
#
# BUILD-STATE.md and retros/INDEX.md are generated by toolbelt/kit-state.sh from the committed
# BUILD-STATE.src.md, ledger.d/ and retros/, and are NOT committed (.gitignore), so a pull that brings a
# new fragment or retro would leave a stale local copy. This hook (and post-checkout / post-rewrite,
# which exec it) runs `kit-state --write` after every merge, checkout and rebase/amend.
# It NEVER blocks git: exit 0 always. Quiet on success. On a failure it prints ONE named warning line
# and deletes both generated files, so no reader is left with stale data.
# Activated with scripts/install-hooks.sh (core.hooksPath .githooks). [ev: retro ledger-generated-not-committed]
set -u

toplevel=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
kit="$toplevel/build-n4-module-kit"
[ -f "$kit/toolbelt/kit-state.sh" ] || exit 0   # a checkout from before kit-state: nothing to generate

if ! err=$(bash "$kit/toolbelt/kit-state.sh" --write "$kit" 2>&1 >/dev/null); then
  rm -f "$kit/BUILD-STATE.md" "$kit/retros/INDEX.md"
  reason=$(grep -m1 . <<<"$err" || true)   # a here-string: no printf to break the pipe of
  printf 'kit-state: could not regenerate BUILD-STATE.md/retros/INDEX.md (%s) — generated files removed\n' \
    "${reason:-kit-state --write failed}" >&2
fi
exit 0
