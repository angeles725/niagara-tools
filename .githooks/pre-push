#!/usr/bin/env bash
# pre-push — the continuity + retro enforcement gate (build-n4-module campaign PR2).
#
# git IS allowed here: a git hook is not a toolbelt/*.sh, so the kit-links.bats L2 rule
# ("no toolbelt script invokes git") does not apply. This hook owns the git-diff half of the
# gate and delegates the content half to toolbelt/sweep-build-state.sh.
#
# Opt-in: enable with `git config core.hooksPath .githooks`. When active it BLOCKS a push that
# changes build-relevant kit files unless the SAME range also carries a BUILD-STATE.md update +
# a pending retro, OR a `Retro: none (trivial: <reason>)` commit trailer. retros/INDEX.md is
# GENERATED (toolbelt/gen-retro-index.sh) from the retro headers, so it need not be in range:
# sweep (the content half) fails the push when the committed index is stale. The kit block's
# last_change, open_issues items and session log are GENERATED from ledger.d/*.md
# (toolbelt/gen-build-state.sh): a new or changed ledger.d/ fragment in range counts as the BUILD-STATE.md
# update of every exit, and sweep fails the push when BUILD-STATE.md is stale against ledger.d/.
# BUILD-STATE.md, ledger.d/ and retros/ are not build-relevant (they need no retro of their own), but they are
# exactly what sweep checks: a range that changes any of them runs sweep at every exit, even the trivial one.
#
# stdin (git pre-push contract): "<local ref> <local sha> <remote ref> <remote sha>" per ref.
set -u

toplevel=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
sweep="$toplevel/build-n4-module-kit/toolbelt/sweep-build-state.sh"

# range from the first ref line; fields 1/3 (refs) are unused
read -r _ lsha _ rsha || exit 0
[ -n "${lsha:-}" ] || exit 0
[[ "$lsha" =~ ^0+$ ]] && exit 0   # deleting a remote branch: nothing is pushed, nothing to gate
refuse() { echo "pre-push: $1; refusing to push unchecked" >&2; exit 1; }
# the content half: ledger + index coherence and generated-file freshness (one call shape for every exit)
run_sweep() {
  bash "$sweep" "$toplevel/build-n4-module-kit/BUILD-STATE.md" \
                "$toplevel/build-n4-module-kit/retros" \
                "$toplevel/build-n4-module-kit/retros/INDEX.md"
}
if [[ "${rsha:-}" =~ ^0*$ ]]; then
  # A new remote branch: gate everything since it left main. Diffing the lone $lsha would compare it with
  # the WORKING TREE (empty after a clean commit) and pass every new branch unchecked.
  base=$(git merge-base origin/main "$lsha" 2>/dev/null || git merge-base origin/HEAD "$lsha" 2>/dev/null) || base=""
  [ -n "$base" ] || refuse "cannot find where $lsha left origin/main (git fetch origin first)"
  range="$base..$lsha"
else
  range="$rsha..$lsha"
fi

changed=$(git diff --name-only "$range") || refuse "git diff $range failed"
log=$(git log --format=%B "$range") || refuse "git log $range failed"

# build-relevant = kit files EXCEPT BUILD-STATE.md, ledger.d/** and retros/**, PLUS scripts/**, PLUS
# go/** except the built go/bin/ (the toolbelt wrappers exec the Go tools, so a go/ change changes lint
# behavior like a toolbelt script change). [ev: retro go-javasrc-scanner Δ1]
relevant=$(printf '%s\n' "$changed" \
  | grep -E '^(build-n4-module-kit/|scripts/|go/)' \
  | grep -vE '^go/bin/' \
  | grep -vE '^build-n4-module-kit/BUILD-STATE\.md$' \
  | grep -vE '^build-n4-module-kit/ledger\.d/' \
  | grep -vE '^build-n4-module-kit/retros/' || true)
# ledger data = the files sweep checks. The two early exits below waive the retro bookkeeping only, never
# the coherence of ledger data the range changes. [ev: retro r10-path-keyed-gates-skip-data]
has_ledger_data=$(printf '%s\n' "$changed" \
  | grep -cE '^build-n4-module-kit/(BUILD-STATE\.md|ledger\.d/|retros/)' || true)
pass_early() {   # exit 0, after sweep when the range changed ledger data
  [ "${has_ledger_data:-0}" -ge 1 ] || exit 0
  run_sweep && exit 0
  local rc=$?
  echo "pre-push: ledger data in range is incoherent (BUILD-STATE.md, ledger.d/ or retros/; sweep-build-state.sh above); refusing to push" >&2
  exit "$rc"
}
[ -n "$relevant" ] || pass_early   # nothing build-relevant → only the content half of changed ledger data

# trivial waiver short-circuits the retro bookkeeping (not the content half of changed ledger data)
if printf '%s\n' "$log" | grep -qE 'Retro: none \(trivial:'; then pass_early; fi

# a ledger.d/ fragment IS a BUILD-STATE.md update (the kit block is generated from it; sweep checks freshness)
has_state=$(printf '%s\n' "$changed" | grep -cE '^build-n4-module-kit/(BUILD-STATE\.md|ledger\.d/[^/]+\.md)$' || true)
has_retro=$(printf '%s\n' "$changed" | grep -E '^build-n4-module-kit/retros/[^/]+\.md$' | grep -vE '/INDEX\.md$' | head -1 || true)
has_index=$(printf '%s\n' "$changed" | grep -cE '^build-n4-module-kit/retros/INDEX\.md$' || true)

# promotion exit (§7 third exit) — folding already-filed lessons into the core. Valid ONLY when it
# carries a STRUCTURAL ANCHOR proving it is a real promotion: an in-range retros/INDEX.md diff (a full
# promotion flips a row), OR an in-range BUILD-STATE.md diff (a PARTIAL promotion folds content but its
# source retro stays pending, so it flips no row — it stamps the owed open_issue in BUILD-STATE, today as
# an `open_issue:` line of a ledger.d/ fragment, which counts as the BUILD-STATE.md anchor).
# The trailer alone is NOT a blanket escape: with NEITHER anchor it falls through to the FAIL below.
# Either anchored path still runs sweep for ledger coherence.
if printf '%s\n' "$log" | grep -qE 'Retro: promotion \(folds' \
   && { [ "${has_index:-0}" -ge 1 ] || [ "${has_state:-0}" -ge 1 ]; }; then
  run_sweep
  exit $?
fi

if [ "${has_state:-0}" -ge 1 ] && [ -n "$has_retro" ]; then
  # content half: the ledger + index must actually cohere, and the generated index must be fresh
  run_sweep
  exit $?
fi

echo "pre-push: build-relevant kit files changed without a BUILD-STATE.md update (or a ledger.d/ fragment) + a pending retro" >&2
echo "          (then run toolbelt/gen-retro-index.sh), and no 'Retro: none (trivial: <reason>)' trailer." >&2
echo "          See BUILD-LOOP.md §7." >&2
exit 1
