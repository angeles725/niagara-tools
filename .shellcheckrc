# ShellCheck project config for niagara-tools.
#
# ci.yml runs `shellcheck` with no --severity, so ANY finding (info/style/warning/error)
# fails the job. Error-level findings are fixed in the source (not disabled here). The codes
# below are pre-existing info/style/warning-level noise; each is a deliberate, documented
# suppression — no executable behavior depends on them.
#
#   SC2317  false positive: helper functions invoked indirectly (awk/callback) read as unreachable
#   SC2129  style: individual `>>` redirects vs `{ ...; } >> file`
#   SC2002  style: "useless cat" in test fixtures (readability)
#   SC2086  info: intentional word-splitting in test fixtures (pre-existing)
#   SC2038  warning: find|xargs over controlled module-tree filenames (no spaces/newlines)
disable=SC2317,SC2129,SC2002,SC2086,SC2038
