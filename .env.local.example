# Per-consumer config for niagara-tools/scripts/ng-deploy.sh.
# Copy this file to .env.local in your consumer module root and edit values.
# .env.local is gitignored; .env.local.example is the only checked-in copy.
# See docs/GOTCHAS.md for path-style and anti-pattern guidance.

# --- Required ---

# MODULE_NAME=chihuahua                        # base name; used in backup filename + jar resolution
# GRADLEW_PATH=/home/cristian/modulos_niagara_n4/Cliente/Honeywell/MX60/chihuahua/gradlew
# NIAGARA_HOME=/mnt/c/Niagara/iC-Niagara-4.13.2.18   # WSL mount of Niagara install dir
# NIAGARA_USER_HOME="/mnt/c/Users/equipo/Niagara4.13/iSMA CONTROLLI"  # quoted: path has spaces
# JAVA_HOME=/usr/lib/jvm/java-8-openjdk-amd64  # Linux JDK used by gradlew in WSL
# STATION_MODULES_DIR=/mnt/c/Honeywell/OptimizerSupervisor-N4.14.0.162/modules  # deploy target

# --- Conditional (required per build mode) ---

# EXPECTED_RT_TYPES=9   # required for mode A or C
# EXPECTED_UX_TYPES=2   # required for mode A or B

# --- Optional ---

# BUILD_ID=20260518a    # when set, verify index.html contains ?v=BUILD_ID
